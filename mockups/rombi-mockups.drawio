"/></mxCell><mxCell id="c176" value="escolher" style="endArrow=classic;html=1;curved=1;strokeWidth=2;strokeColor=#2877bc;fontSize=12;fontColor=#2877bc;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c143" target="c162"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c177" value="Mobile — editor por blocos&lt;br&gt;• Toque no + abre uma janela (modal) com as opções&lt;br&gt;• Opções: Menu, Wi-Fi, Horário, Avaliar no Google, Galeria, Jogos e Cartão de recomendações&lt;br&gt;• O Menu mostra quantos usos restam no plano (ex.: 2 usos restantes)&lt;br&gt;• Os blocos escolhidos aparecem no perfil público (ecrã 3)&lt;br&gt;• A janela do + será feita com JavaScript na Entrega 3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fillColor=#FFF2A8;strokeColor=#d6b656;fontSize=13;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="0" y="660" width="560" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pag4" name="Criar Perfil · Desktop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c224" value="" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.containers.browserWindow;rSize=0;strokeColor=#666666;strokeColor2=#2877bc;strokeColor3=#c4c4c4;mainText=,;recursiveResize=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="1060" as="geometry"/></mxCell><mxCell id="c225" value="Criar Perfil | ROMBI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="12" width="220" height="26" as="geometry"/></mxCell><mxCell id="c226" value="https://rombi.pt/criar-perfil" style="text;html=1;strokeColor=none;fillCol